    "desktop:dev": "node scripts/desktop-dev.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "main": "electron/main.cjs"
}
