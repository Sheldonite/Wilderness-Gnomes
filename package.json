{
  "name": "wilderness-gnomes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/run.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
